DATABASE_URL=postgres://learnquest:learnquest@localhost:5432/learnquest
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:5173
# BETTER_AUTH_URL defaults to PUBLIC_ORIGIN
PORT=3000
NODE_ENV=development
# Set to your reverse proxy address (e.g. 10.0.0.5) so per-IP rate limits see real clients. Unset = trust no forwarded IP.
# TRUSTED_PROXY=
# Enables the "Learn anything" AI path builder. Unset = paths.generate is disabled.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
